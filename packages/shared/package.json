{
  "name": "@aegis/shared",
  "version": "1.46.0-beta",
  "private": true,
  "description": "Aegis contract layer: shared TS types, card-data types, Colyseus state schema, and the client/server protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#shared/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    },
    "./protocol/*": {
      "types": "./dist/protocol/*.d.ts",
      "default": "./dist/protocol/*.js"
    },
    "./cards/*": {
      "types": "./dist/cards/*.d.ts",
      "default": "./dist/cards/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "node ../../tools/typescript/tsc.mjs small -w -p tsconfig.json --singleThreaded",
    "build": "node ../../tools/typescript/tsc.mjs small -p tsconfig.build.json --singleThreaded && pnpm run copy:data",
    "copy:data": "node scripts/copy-data.mjs",
    "typecheck": "node ../../tools/typescript/tsc.mjs small --noEmit -p tsconfig.json --singleThreaded",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.34"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
