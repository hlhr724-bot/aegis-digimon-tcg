{
  "name": "aegis",
  "version": "1.46.0-beta",
  "private": true,
  "description": "Aegis - a server-authoritative Digimon-style trading card game (React + PixiJS client, Colyseus API).",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test:deploy": "node --test tools/deploy/*.test.mjs",
    "card-images:import": "node tools/import-clean-card-images.mjs",
    "logs:match": "node tools/match-logs.mjs",
    "client-error": "node tools/client-errors/client-error.mjs",
    "replay": "pnpm --silent --filter @aegis/api replay",
    "scenario": "node tools/scenario.mjs",
    "motion:reference": "node tools/diagnostics/prepare-motion-reference.mjs",
    "motion:capture": "node tools/diagnostics/capture-field-focus.mjs",
    "motion:probe:field-light": "node tools/diagnostics/probe-field-activation-light.mjs",
    "motion:probe:shuffle": "node tools/diagnostics/probe-deck-shuffle.mjs",
    "motion:probe:breeding": "node tools/diagnostics/probe-breeding-transfer.mjs",
    "motion:probe:breeding-playback": "node tools/diagnostics/probe-breeding-playback.mjs",
    "motion:probe:result": "node tools/diagnostics/probe-match-result.mjs",
    "motion:probe:deck-returns": "node tools/diagnostics/probe-deck-returns.mjs",
    "motion:probe:hand-returns": "node tools/diagnostics/probe-hand-returns.mjs",
    "motion:probe:stack-strips": "node tools/diagnostics/probe-stack-strips.mjs",
    "motion:probe:central-shatter": "node tools/diagnostics/probe-central-shatter.mjs",
    "motion:probe:particle-light": "node tools/diagnostics/probe-particle-light.mjs",
    "motion:probe:notice-lanes": "node tools/diagnostics/probe-notice-lanes.mjs",
    "motion:probe:particle-queue": "node tools/diagnostics/probe-particle-queue.mjs",
    "motion:probe:particle-lifecycle": "node tools/diagnostics/probe-particle-lifecycle.mjs",
    "motion:probe:security-light": "node tools/diagnostics/probe-security-light.mjs",
    "motion:probe:field-shatter": "node tools/diagnostics/probe-field-shatter.mjs",
    "motion:capture:reveals": "node tools/diagnostics/capture-card-reveals.mjs",
    "motion:capture:arrows": "node tools/diagnostics/capture-target-arrows.mjs",
    "motion:capture:impacts": "node tools/diagnostics/capture-combat-impacts.mjs",
    "motion:capture:security": "node tools/diagnostics/capture-security-reveals.mjs",
    "motion:capture:security:exits": "node tools/diagnostics/capture-security-exits.mjs",
    "motion:capture:transfers": "node tools/diagnostics/capture-security-transfers.mjs",
    "motion:capture:bursts": "node tools/diagnostics/capture-card-bursts.mjs",
    "motion:capture:hatches": "node tools/diagnostics/capture-hatches.mjs",
    "motion:capture:trash": "node tools/diagnostics/capture-trash-sources.mjs",
    "motion:capture:hands": "node tools/diagnostics/capture-hand-sources.mjs",
    "motion:probe:hands": "node tools/diagnostics/probe-hand-focus-lifecycle.mjs",
    "motion:capture:hand-arrivals": "node tools/diagnostics/capture-hand-arrivals.mjs",
    "motion:capture:hand-transfers": "node tools/diagnostics/capture-hand-transfers.mjs",
    "motion:capture:draws": "node tools/diagnostics/capture-draw-presentations.mjs",
    "motion:measure:hands": "node tools/diagnostics/measure-hand-hover.mjs",
    "motion:capture:hand-hover": "node tools/diagnostics/capture-hand-hover.mjs",
    "motion:measure:draw-light": "node tools/diagnostics/measure-draw-light.mjs",
    "motion:measure:opponent-entry": "node tools/diagnostics/measure-opponent-hand-entry.mjs",
    "motion:measure:draw-path": "node tools/diagnostics/measure-draw-path.mjs",
    "motion:measure:attacks": "node tools/diagnostics/measure-confirmed-attack.mjs",
    "fuzz:battles": "pnpm --filter @aegis/api fuzz:battles",
    "verify:simulator": "pnpm --filter @aegis/shared build && pnpm --filter @aegis/api typecheck && pnpm --filter @aegis/api test:verification && node --test tools/kb/check-rules-freshness.test.mjs tools/kb/rule-obligations.test.mjs && node tools/kb/rule-obligations.mjs --check && node tools/kb/check-conformance-citations.mjs && pnpm lint",
    "verify:simulator:deep": "pnpm verify:simulator && pnpm verify:rules-source && pnpm test:tools && pnpm --filter @aegis/api test:conformance && pnpm --filter @aegis/api test && FUZZ_CASES=1000 FUZZ_STEPS=16 pnpm --filter @aegis/api exec vitest run src/engine/fuzzer.test.ts && pnpm --filter @aegis/api build && node apps/api/dist/bot/battleFuzzerCli.js --newest --deck-limit 2 --matchups 4 --seeds 2 --turn-limit 60",
    "verify:rules-source": "node tools/kb/check-rules-freshness.mjs",
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"pnpm --filter @aegis/shared dev\" \"pnpm --filter @aegis/api dev\" \"pnpm --filter @aegis/web dev\"",
    "build": "pnpm --filter @aegis/shared build && pnpm --filter @aegis/api build && pnpm --filter @aegis/web build",
    "typecheck": "pnpm --filter @aegis/shared build && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:tools": "node --test tools/*.test.mjs tools/kb/*.test.mjs tools/client-errors/*.test.mjs tools/typescript/*.test.mjs tools/translations/*.test.mjs",
    "translations:fragments": "pnpm --filter @aegis/web exec vitest run src/i18n/cardTextFragmentCoverage.test.ts",
    "translations:audit": "node tools/translations/audit-card-translations.mjs",
    "translations:check": "node tools/translations/audit-card-translations.mjs --check",
    "effects:sync:set": "node tools/sync-effects-from-card-modules.mjs",
    "effects:check:set": "node tools/sync-effects-from-card-modules.mjs --check",
    "ci": "pnpm check && pnpm typecheck && pnpm test:tools && pnpm test",
    "lint": "oxlint .",
    "lint:cards": "oxlint apps/api/src/cards",
    "lint:files": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:cards": "oxfmt apps/api/src/cards",
    "format:cards:check": "oxfmt --check apps/api/src/cards",
    "format:files": "oxfmt",
    "format:files:check": "oxfmt --check",
    "check:style": "pnpm lint && pnpm format:check",
    "check": "pnpm check:style",
    "check:fix": "pnpm exec oxlint --fix . && pnpm format",
    "check:cards:style": "pnpm lint:cards && pnpm format:cards:check",
    "start": "pnpm --filter @aegis/api start",
    "clean": "pnpm -r exec rm -rf dist",
    "release:check": "node tools/release/version.mjs check",
    "release:set": "node tools/release/version.mjs set",
    "release:current": "node tools/release/version.mjs current",
    "release:notes": "node tools/release/render-notes.mjs",
    "release:publish": "node tools/release/publish.mjs",
    "typecheck:tests": "pnpm --filter @aegis/shared build && pnpm --filter @aegis/api typecheck:tests"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "source-map": "^0.7.6",
    "typescript": "~7.0.2",
    "typescript-api": "npm:typescript@~5.8.3"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.30.1"
}
