{
  "name": "@aegis/web",
  "version": "1.46.0-beta",
  "private": true,
  "description": "Aegis client: React + TypeScript + Vite. A pure function of synchronized state; sends intents, contains no rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../tools/translations/audit-card-translations.mjs --check && node ../../tools/typescript/tsc.mjs web -p tsconfig.build.json --singleThreaded && vite build && node scripts/precompress-assets.mjs",
    "preview": "vite preview",
    "typecheck": "node ../../tools/typescript/tsc.mjs web --noEmit -p tsconfig.json --singleThreaded",
    "test": "vitest run --passWithNoTests",
    "pacing:measure": "PACING_MEASURE=1 vitest run test/pacing/pacing.measure.test.ts",
    "pacing:baseline": "PACING_MEASURE=1 PACING_UPDATE_BASELINE=1 vitest run test/pacing/pacing.measure.test.ts",
    "test:browser": "pnpm --filter @aegis/shared build && pnpm --filter @aegis/api build && NODE_OPTIONS=--max-old-space-size=2048 playwright test"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "@colyseus/sdk": "^0.18.4",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.1.1",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "colyseus": "^0.18.8",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  }
}
