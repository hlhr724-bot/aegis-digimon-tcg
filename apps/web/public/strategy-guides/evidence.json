          },
          {
            "feature": "playTamer",
            "weight": 2,
            "advice": "Establish Tamers when you can afford the tempo investment."
          },
          {
            "feature": "hatch",
            "weight": 10,
            "advice": "Hatch when the breeding area is empty."
          },
          {
            "feature": "deploy",
            "weight": 2,
            "advice": "Move a developed line out to contest the board."
          },
          {
            "feature": "criticalBlock",
